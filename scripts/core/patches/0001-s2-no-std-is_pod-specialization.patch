realm-core 20.1.0: the s2 macros DECLARE_POD and PROPAGATE_POD_FROM_TEMPLATE_ARGUMENT no longer specialize std::is_pod.
libc++ of Xcode 26.6 rejects it (error: 'is_pod' cannot be specialized, -Winvalid-specialization). Same change as the
one afterdb ships in the xcframework headers (realm/realm-js#7115, bridge/build.mjs step 5).

diff --git a/src/external/s2/base/macros.h b/src/external/s2/base/macros.h
index eaf28fe..c62fadc 100644
--- a/src/external/s2/base/macros.h
+++ b/src/external/s2/base/macros.h
@@ -161,9 +161,6 @@ char (&ArraySizeHelper(const T (&array)[N]))[N];
 // variables must themselves be PODs.
 
 #define DECLARE_POD(TypeName)                       \
-namespace std {                                    \
-template<> struct is_pod<TypeName> : true_type { }; \
-}                                                   \
 typedef int Dummy_Type_For_DECLARE_POD              \
 
 // We once needed a different technique to assert that a nested class
@@ -177,9 +174,6 @@ typedef int Dummy_Type_For_DECLARE_POD              \
 
 // Declare that TemplateName<T> is a POD whenever T is
 #define PROPAGATE_POD_FROM_TEMPLATE_ARGUMENT(TemplateName)             \
-namespace std {                                                       \
-template <typename T> struct is_pod<TemplateName<T> > : std::is_trivial<T> { }; \
-}                                                                      \
 typedef int Dummy_Type_For_PROPAGATE_POD_FROM_TEMPLATE_ARGUMENT
 
 // Macro that does nothing if TypeName is a POD, and gives a compiler
